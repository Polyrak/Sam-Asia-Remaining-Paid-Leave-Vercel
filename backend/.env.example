# --- OpenProject connection ---
OPENPROJECT_URL=https://openproject.example.com
OPENPROJECT_API_KEY=your_api_key_here

# --- Server ---
PORT=4000
CACHE_TTL_SECONDS=60

# --- Leave tracking configuration ---
# Leave these blank at first, start the server, open the app's Settings page
# and click "Run discovery" to find the correct values for your instance.

# Project whose members are shown on the dashboard as employees
OP_LEAVE_PROJECT_ID=

# The shared work package employees log their paid-leave time entries against
# (e.g. a "Paid leave" work package under a LEAVES-style type)
OP_PAID_LEAVE_WORK_PACKAGE_ID=

# Hours per full workday, used to convert logged hours into days
OP_HOURS_PER_DAY=8
